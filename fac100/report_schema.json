{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/fac100/report_schema.json",
  "title": "FAC-100 execution report",
  "description": "Schema for report.json produced by the fac100 admission challenge run. The validator in validate_report.py implements the subset of JSON Schema used here, plus report-specific cross-checks that JSON Schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "reasoning",
    "software_engineering",
    "research",
    "agentic_execution",
    "reliability",
    "scoring",
    "evidence_index"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "title", "generated_utc", "schema_version", "sandbox"],
      "properties": {
        "report_id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "generated_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sandbox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "python", "cpu_count", "network_access"],
          "properties": {
            "os": {"type": "string"},
            "python": {"type": "string"},
            "cpu_count": {"type": "integer", "minimum": 1},
            "network_access": {"type": "string"}
          }
        }
      }
    },
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["problem_id", "valid_orderings", "count", "unique", "reasoning_steps", "enumeration"],
      "properties": {
        "problem_id": {"type": "string"},
        "valid_orderings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sequence", "slots"],
            "properties": {
              "sequence": {"type": "string", "minLength": 5, "maxLength": 5},
              "slots": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "string"}}
            }
          }
        },
        "count": {"type": "integer", "minimum": 1},
        "unique": {"type": "boolean"},
        "reasoning_steps": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 10}},
        "enumeration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["permutations_enumerated", "brute_force_count", "constructive_count", "methods_agree", "script"],
          "properties": {
            "permutations_enumerated": {"type": "integer", "minimum": 1},
            "brute_force_count": {"type": "integer", "minimum": 0},
            "constructive_count": {"type": "integer", "minimum": 0},
            "methods_agree": {"type": "boolean"},
            "script": {"type": "string"},
            "evidence": {"type": "string"}
          }
        }
      }
    },
    "software_engineering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "money_unit", "tests", "requirements_coverage", "mutation_probe",
                   "defects_found_and_fixed"],
      "properties": {
        "package": {"type": "string"},
        "money_unit": {"type": "string", "const": "integer cents"},
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "passed", "failed", "skipped", "csv", "summary", "run_command"],
          "properties": {
            "total": {"type": "integer", "minimum": 1},
            "passed": {"type": "integer", "minimum": 0},
            "failed": {"type": "integer", "minimum": 0},
            "skipped": {"type": "integer", "minimum": 0},
            "csv": {"type": "string"},
            "summary": {"type": "string"},
            "run_command": {"type": "string"},
            "repeat_concurrency_runs": {"type": "integer", "minimum": 1},
            "repeat_concurrency_tests_passed": {"type": "integer", "minimum": 0}
          }
        },
        "requirements_coverage": {
          "type": "array",
          "minItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requirement", "status", "evidence"],
            "properties": {
              "requirement": {"type": "string", "minLength": 5},
              "status": {"type": "string", "enum": ["covered", "partially_covered", "not_covered"]},
              "evidence": {"type": "string", "minLength": 1}
            }
          }
        },
        "mutation_probe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lock_removed_detected", "refund_cap_disabled_detected", "evidence"],
          "properties": {
            "lock_removed_detected": {"type": "boolean"},
            "refund_cap_disabled_detected": {"type": "boolean"},
            "evidence": {"type": "string"}
          }
        },
        "defects_found_and_fixed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description", "resolution"],
            "properties": {
              "id": {"type": "string", "pattern": "^BUG-[0-9]+$"},
              "description": {"type": "string", "minLength": 10},
              "resolution": {"type": "string", "minLength": 10}
            }
          }
        }
      }
    },
    "research": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questions", "conflicts", "limitations"],
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "question", "answer", "confidence", "sources"],
            "properties": {
              "id": {"type": "string", "pattern": "^Q[0-9]+$"},
              "question": {"type": "string", "minLength": 10},
              "answer": {"type": "string", "minLength": 30},
              "confidence": {"type": "string", "enum": ["verified", "partially_verified", "not_documented"]},
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["title", "url", "accessed"],
                  "properties": {
                    "title": {"type": "string", "minLength": 3},
                    "url": {"type": "string", "pattern": "^https://"},
                    "published": {"type": "string"},
                    "last_updated": {"type": "string"},
                    "accessed": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
                    "quote": {"type": "string"}
                  }
                }
              }
            }
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["topic", "sources", "assessment"],
            "properties": {
              "topic": {"type": "string", "minLength": 5},
              "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "assessment": {"type": "string", "minLength": 20}
            }
          }
        },
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}}
      }
    },
    "agentic_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_dir", "deliverables", "validation_experiment"],
      "properties": {
        "project_dir": {"type": "string", "const": "fac100"},
        "deliverables": {
          "type": "array",
          "minItems": 11,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "kind", "exists"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "enum": ["file", "directory"]},
              "exists": {"type": "boolean", "const": true},
              "bytes": {"type": "integer", "minimum": 0},
              "note": {"type": "string"}
            }
          }
        },
        "validation_experiment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["steps", "passed", "original_report_unchanged", "evidence"],
          "properties": {
            "steps": {
              "type": "array",
              "minItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["step", "action", "command", "exit_code", "observed"],
                "properties": {
                  "step": {"type": "integer", "minimum": 1},
                  "action": {"type": "string", "minLength": 5},
                  "command": {"type": "string", "minLength": 5},
                  "exit_code": {"type": "integer"},
                  "observed": {"type": "string", "minLength": 5}
                }
              }
            },
            "passed": {"type": "boolean"},
            "original_report_unchanged": {"type": "boolean"},
            "evidence": {"type": "string"}
          }
        }
      }
    },
    "reliability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_failure_modes", "assumptions", "research_limitations",
                   "unavailable_capabilities", "errors_encountered", "unmet_requirements",
                   "residual_risks"],
      "properties": {
        "production_failure_modes": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 20}},
        "assumptions": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 10}},
        "research_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
        "unavailable_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
        "errors_encountered": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 10}},
        "unmet_requirements": {"type": "array", "items": {"type": "string", "minLength": 5}},
        "residual_risks": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 15}}
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categories", "total", "max_total", "thresholds", "minimum_gates", "verdict", "disclaimer"],
      "properties": {
        "categories": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "score", "max", "justification", "deductions"],
            "properties": {
              "name": {"type": "string", "enum": ["reasoning", "coding", "research", "agent_execution", "reliability"]},
              "score": {"type": "number", "minimum": 0},
              "max": {"type": "number", "minimum": 1},
              "justification": {"type": "string", "minLength": 40},
              "deductions": {"type": "array", "items": {"type": "string", "minLength": 5}},
              "evidence_refs": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "total": {"type": "number", "minimum": 0, "maximum": 100},
        "max_total": {"type": "number", "const": 100},
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strong_pass", "pass", "borderline"],
          "properties": {
            "strong_pass": {"type": "number"},
            "pass": {"type": "number"},
            "borderline": {"type": "number"}
          }
        },
        "minimum_gates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["coding_min", "coding_actual", "agent_execution_min", "agent_execution_actual"],
          "properties": {
            "coding_min": {"type": "number", "minimum": 0},
            "coding_actual": {"type": "number", "minimum": 0},
            "agent_execution_min": {"type": "number", "minimum": 0},
            "agent_execution_actual": {"type": "number", "minimum": 0}
          }
        },
        "verdict": {"type": "string", "enum": ["STRONG_PASS", "PASS", "BORDERLINE", "FAIL"]},
        "disclaimer": {"type": "string", "minLength": 40}
      }
    },
    "evidence_index": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "description"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 10}
        }
      }
    }
  }
}
